rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidRecord(data) {
      return data.userId == request.auth.uid &&
             data.tipo in ['IDEIA', 'COMPRA', 'LEMBRETE', 'TAREFA', 'INSIGHT', 'REFLEXAO', 'SENTIMENTO', 'COMPROMISSO', 'FINANCAS', 'REFERENCIA'] &&
             data.prioridade in ['ALTA', 'MEDIA', 'BAIXA'] &&
             data.conteudo is string && data.conteudo.size() <= 10000 &&
             data.createdAt is timestamp &&
             (data.get('dataHoraDetectada', null) == null || data.dataHoraDetectada is string) &&
             (data.get('local', null) == null || data.local is string) &&
             (data.get('mapsUrl', null) == null || data.mapsUrl is string) &&
             (data.get('wazeUrl', null) == null || data.wazeUrl is string) &&
             (data.get('status', 'PENDING') in ['PENDING', 'COMPLETED']);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      
      match /records/{recordId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        
        allow create: if isOwner(userId) && 
                         isValidId(recordId) && 
                         isValidRecord(incoming()) &&
                         incoming().createdAt == request.time;
                         
        allow update: if isOwner(userId) && 
                         isValidRecord(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'tipo', 'prioridade', 'conteudo', 'insight', 'tags', 
                           'dataHoraDetectada', 'local', 'mapsUrl', 'wazeUrl', 'updatedAt', 'status'
                         ]);
                         
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow get, write: if isOwner(userId);
      }

      match /stats/{statId} {
        allow list, get, write: if isOwner(userId);
      }
    }
  }
}
